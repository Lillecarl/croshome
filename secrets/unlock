#!/usr/bin/env bash
# Put the age identity where activation can read it.
#
#   ./secrets/unlock [--status|--lock|--help]
#
# A bare script on purpose. It runs before a machine is activated for the first
# time, so it cannot be a package that activation installs -- that is the
# bootstrap it exists to break. It needs nothing but bash, and it finds `age`
# through nix when the machine does not have one yet.
#
# It asks for the passphrase of ./identity.age and writes the plaintext to
# /var/lib/agenix/identity, root-owned and 0600. ./default.nix names that path
# in `age.identityPaths`, so activation reads it from there.
#
# Run it once per machine. The file survives reboots, which is the point: the
# agenix activation at boot has no terminal and cannot be asked for a
# passphrase. Editing a secret is the other half and does not use this file at
# all -- see ./README.md.
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
encrypted="$here/identity.age"
target=${AGENIX_IDENTITY:-/var/lib/agenix/identity}

# The header comment is the help text. Printed by walking from the line after
# the shebang to the first line that is not a comment, so editing the header
# cannot leave a line count behind to drift.
usage() {
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' \
    "${BASH_SOURCE[0]}"
}

# `age` is in the system path once a machine is activated, and absent on one
# that never has been. Falling back to nix is what makes this usable on a fresh
# machine, which is the only time it is strictly needed.
age_cmd() {
  if command -v age >/dev/null 2>&1; then
    age "$@"
  else
    echo "unlock: no age on PATH, running it from nixpkgs" >&2
    nix --extra-experimental-features 'nix-command flakes' \
      run nixpkgs#age -- "$@"
  fi
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
--status)
  # A plain test, no sudo. The directory is traversable and only the file is
  # restricted, so anyone can see whether it is there and nobody but root can
  # read it.
  if [ -f "$target" ]; then
    echo "unlocked: $target"
  else
    echo "locked: $target does not exist"
    exit 1
  fi
  exit 0
  ;;
--lock)
  sudo rm -f "$target"
  echo "locked: removed $target"
  exit 0
  ;;
"") ;;
*)
  usage
  exit 1
  ;;
esac

if [ ! -f "$encrypted" ]; then
  echo "unlock: $encrypted does not exist" >&2
  echo "unlock: see $here/README.md to create it" >&2
  exit 1
fi

if [ -f "$target" ]; then
  echo "already unlocked: $target"
  echo "run '$0 --lock' first to replace it"
  exit 0
fi

# Decrypt as the user, so the passphrase prompt reaches this terminal and the
# plaintext never passes through a sudo environment. `install` then moves it
# into place with the mode and owner set in one step, so there is no moment
# where the file is readable by anyone else.
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
chmod 600 "$tmp"

echo "unlocking $encrypted"

# Read the work factor out of the file rather than carry a number here. A
# hardcoded one goes stale the moment the identity is re-encrypted, which is
# exactly what happened to the last version of this line.
#
# scrypt memory is 128 * r * N with r=8, so 2^logN KiB, so 2^(logN-10) MiB.
# Best effort: if the header will not parse, say nothing rather than guess.
work_factor() {
  local hdr
  if head -1 "$1" | grep -q "BEGIN AGE"; then
    # Armored. The header is in the first few base64 lines. GNU base64 wants
    # -d and BSD wants -D, and a machine that has never been activated may
    # have either.
    hdr=$(sed -n '2,4p' "$1" | tr -d '\n' | { base64 -d 2>/dev/null || base64 -D 2>/dev/null; })
  else
    hdr=$(head -c 200 "$1")
  fi
  printf '%s' "$hdr" | awk '/-> scrypt/ { print $4; exit }'
}

wf=$(work_factor "$encrypted" || true)
if [ -n "$wf" ] && [ "$wf" -ge 10 ] 2>/dev/null; then
  echo "scrypt at work factor $wf: about $((1 << (wf - 10))) MiB, and it will pause"
fi

age_cmd --decrypt -o "$tmp" "$encrypted"

# 755 on the directory and 600 on the file. The directory is traversable so
# --status needs no sudo; the key is root-only, which is what actually matters.
sudo install -d -m 755 -o root "$(dirname "$target")"
sudo install -m 600 -o root "$tmp" "$target"

echo "unlocked: $target"
echo "activate now, and agenix will decrypt with it"
