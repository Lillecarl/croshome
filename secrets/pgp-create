#!/usr/bin/env bash
# Create the two OpenPGP keys this configuration signs with.
#
#   ./secrets/pgp-create [--help]
#
# Run this once, ever, on one machine. It makes both keys, encrypts each
# secret key to the age identity in ./identity.age, writes the public halves
# and the fingerprints, and imports both into this machine's GnuPG. Every
# other machine then runs ./pgp-import instead.
#
# The two identities:
#
#   work       Carl Andersson <carl.andersson@dynamist.se>
#   personal   lillecarl <prettygood@lillecarl.com>
#
# Each key is an ed25519 primary that only certifies, with an ed25519 signing
# subkey and a cv25519 encryption subkey under it. That is the layout worth
# having: the primary is the identity and rarely leaves storage, and a subkey
# is what does the daily work and can be replaced without changing who you are.
#
# Both keys expire in two years. Renewal is one command and does not change
# the fingerprint, so nothing downstream has to be updated:
#
#   gpg --quick-set-expire <fingerprint> 2y '*'
#
# Two passphrases guard the result and neither is optional. The key's own
# passphrase, asked for below, protects the export before age ever sees it.
# The age passphrase protects it again in this public repository. Lose either
# one and the key is gone -- put both in a password manager.
#
# This must run in a terminal, because it asks for a passphrase. From an
# agent's shell, ask a person to run it.
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

usage() {
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' \
    "${BASH_SOURCE[0]}"
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
"") ;;
*)
  usage
  exit 1
  ;;
esac

# The identities this script makes, and the file names they land in. Keep the
# `.age` names in step with ./secrets.nix: agenix decides the recipients from
# that file by name, so a name that is not there has no rule and cannot be
# rekeyed later.
work_uid="Carl Andersson <carl.andersson@dynamist.se>"
personal_uid="lillecarl <prettygood@lillecarl.com>"

for tool in gpg age; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "pgp-create: no $tool on PATH" >&2
    echo "pgp-create: rebuild first -- ../home/gpg.nix installs gpg" >&2
    exit 1
  }
done

if [ ! -t 0 ]; then
  echo "pgp-create: this needs a terminal, it asks for a passphrase" >&2
  exit 1
fi

for name in pgp-work.age pgp-personal.age; do
  if [ -e "$here/$name" ]; then
    echo "pgp-create: $here/$name already exists" >&2
    echo "pgp-create: the keys are made. Use ./pgp-import on this machine." >&2
    exit 1
  fi
done

# The recipient, read out of ./secrets.nix rather than written again here. The
# two must agree exactly or the next `agenix -r` rewrites these files, and the
# way to make two copies agree forever is to keep one.
recipient=$(sed -n 's/^ *lillecarl-age = "\(age1[^"]*\)".*/\1/p' "$here/secrets.nix")
if [ -z "$recipient" ]; then
  echo "pgp-create: could not read lillecarl-age out of $here/secrets.nix" >&2
  exit 1
fi
echo "encrypting to $recipient"
echo

# One passphrase for both keys. Two would be more correct and would be typed
# so rarely that neither would be remembered, which is worse.
echo "Choose the passphrase for both OpenPGP keys."
echo "This is not the age passphrase. Both are needed, and both must survive."
read -r -s -p "passphrase: " pw
echo
read -r -s -p "again: " pw2
echo
if [ -z "$pw" ]; then
  echo "pgp-create: refusing an empty passphrase" >&2
  exit 1
fi
if [ "$pw" != "$pw2" ]; then
  echo "pgp-create: the two do not match" >&2
  exit 1
fi
unset pw2
echo

# A scratch GnuPG home, so a failure half way leaves nothing behind in the
# real one. What survives is what this script deliberately exports.
tmphome=$(mktemp -d)
chmod 700 "$tmphome"
cleanup() {
  gpgconf --homedir "$tmphome" --kill all >/dev/null 2>&1 || true
  rm -rf "$tmphome"
}
trap cleanup EXIT

# The passphrase reaches gpg over a pipe on fd 3, never a file and never a
# command line. `--pinentry-mode loopback` is what makes gpg take it from
# there instead of asking the agent to draw a prompt.
g() {
  gpg --homedir "$tmphome" --batch --yes --no-tty \
    --pinentry-mode loopback --passphrase-fd 3 "$@" 3< <(printf '%s' "$pw")
}

fingerprint_of() {
  g --list-keys --with-colons "$1" | awk -F: '/^fpr:/ { print $10; exit }'
}

# Everything but the fingerprint goes to stderr: the caller reads stdout to
# learn the fingerprint, so a stray progress line would end up inside it.
make_key() {
  local uid=$1 fpr

  echo "generating $uid" >&2
  g --quick-generate-key "$uid" ed25519 cert 2y >&2

  fpr=$(fingerprint_of "$uid")
  if [ -z "$fpr" ]; then
    echo "pgp-create: no fingerprint for $uid" >&2
    exit 1
  fi

  g --quick-add-key "$fpr" ed25519 sign 2y >&2
  g --quick-add-key "$fpr" cv25519 encr 2y >&2

  printf '%s' "$fpr"
}

work_fpr=$(make_key "$work_uid")
personal_fpr=$(make_key "$personal_uid")
echo

# The export is already encrypted with the key's passphrase. age adds the
# second layer. `-a` keeps it ASCII so it diffs in git, and ./secrets.nix says
# `armor = true` for both files to match.
export_key() {
  local fpr=$1 name=$2

  g --export-secret-keys --armor "$fpr" |
    age -r "$recipient" -a -o "$here/$name.age"

  g --export --armor "$fpr" >"$here/$name.pub.asc"
  echo "wrote $name.age and $name.pub.asc"
}

export_key "$work_fpr" pgp-work
export_key "$personal_fpr" pgp-personal
echo

# Fingerprints, for ../home/gpg.nix and ../home/vcs.nix to read at evaluation
# time. Generated rather than transcribed: forty hex characters typed twice is
# a mistake waiting to be made, and it would show up as a signing failure far
# from here.
cat >"$here/pgp-keys.nix" <<NIX
# The fingerprints of the two OpenPGP keys in this directory.
#
# Generated by ./pgp-create. Do not edit: it rewrites this file whole.
#
# Committed, because ../home/gpg.nix and ../home/vcs.nix read it at evaluation
# time and a fresh clone has to find it. Nothing secret is here -- a
# fingerprint is the public name of a key.
{
  # $work_uid
  work = "$work_fpr";

  # $personal_uid
  personal = "$personal_fpr";
}
NIX
echo "wrote pgp-keys.nix"
echo

# Into the real GnuPG, so the machine that made the keys can use them without
# a round trip through ./pgp-import.
realhome=$(gpgconf --list-dirs homedir)
echo "importing into $realhome"
for fpr in "$work_fpr" "$personal_fpr"; do
  g --export-secret-keys "$fpr" | gpg --batch --quiet --import

  # Ultimate trust, which gpg does not set on its own even for a key whose
  # secret half is present. Without it gpg calls your own key untrusted and
  # asks before encrypting to it.
  printf '%s:6:\n' "$fpr" | gpg --batch --quiet --import-ownertrust

  # The revocation certificate gpg wrote when it made the key. It is in the
  # scratch home, which this script deletes, so put it where gpg would have.
  # It is the one way to retire a key whose passphrase is lost, and it is
  # sensitive in its own right: whoever holds it can revoke the key. It stays
  # on this machine only, and it is not in the repository.
  install -D -m 600 "$tmphome/openpgp-revocs.d/$fpr.rev" \
    "$realhome/openpgp-revocs.d/$fpr.rev"
done
unset pw
echo

# Prove the backup opens before trusting it. An unreadable age file is not
# discovered later, it is discovered never -- and this is the only copy.
echo "Checking that both age files decrypt. The age passphrase, once per file."
for pair in "$work_fpr:pgp-work" "$personal_fpr:pgp-personal"; do
  fpr=${pair%%:*}
  name=${pair#*:}
  got=$(age -d -i "$here/identity.age" "$here/$name.age" |
    gpg --batch --quiet --show-keys --with-colons |
    awk -F: '/^fpr:/ { print $10; exit }')
  if [ "$got" != "$fpr" ]; then
    echo "pgp-create: $name.age does not hold $fpr (got '${got:-nothing}')" >&2
    exit 1
  fi
  echo "  $name.age holds $fpr"
done
echo

cat <<DONE
Done. Both keys exist and both backups open.

  work      $work_fpr
  personal  $personal_fpr

Next:

  1. commit pgp-work.age, pgp-personal.age, the two .pub.asc files
     and pgp-keys.nix
  2. rebuild, so signing turns on -- see ../home/vcs.nix
  3. on every other machine: ./secrets/pgp-import

The revocation certificates are in $realhome/openpgp-revocs.d and stay on
this machine. They are not in the repository, and they are what retires a
key whose passphrase is lost. Back them up somewhere you trust.
DONE
