#!/usr/bin/env bash
# Put the OpenPGP keys into this machine's GnuPG.
#
#   ./secrets/pgp-import [work|personal|both]   both is the default
#   ./secrets/pgp-import --status               what is here already
#
# Run this once per machine. It asks for the age passphrase, decrypts the key
# out of this directory, and imports it. GnuPG keeps it afterwards, so nothing
# has to run again at boot or at login.
#
# That is why nothing here uses the agenix home-manager module. That module
# exists for a secret that must be a file at runtime, so it decrypts on every
# login and needs an identity a user can read without a passphrase. An OpenPGP
# key is not that: it goes into GnuPG's own store once and stays. So the
# system agenix in ../secrets/default.nix stays the only agenix in this
# repository, and the identity stays root-only.
#
# The key is still passphrase-protected after it is imported. gpg-agent caches
# it -- see ../home/gpg.nix for how long.
#
# ./pgp-create makes the keys. Run that once, on one machine, before this.
#
# This must run in a terminal, because it asks for a passphrase. From an
# agent's shell, ask a person to run it.
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

usage() {
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' \
    "${BASH_SOURCE[0]}"
}

# The fingerprints ./pgp-create wrote. Read out of the nix file rather than
# repeated here, for the same reason ./pgp-create reads the age recipient out
# of ./secrets.nix: one copy cannot disagree with itself.
fingerprint() {
  sed -n "s/^ *$1 = \"\([0-9A-Fa-f]\{40\}\)\".*/\1/p" "$here/pgp-keys.nix"
}

work_fpr=$(fingerprint work)
personal_fpr=$(fingerprint personal)

present() {
  gpg --list-secret-keys "$1" >/dev/null 2>&1
}

case "${1:-both}" in
-h | --help)
  usage
  exit 0
  ;;
--status)
  for pair in "work:$work_fpr" "personal:$personal_fpr"; do
    name=${pair%%:*}
    fpr=${pair#*:}
    if [ -z "$fpr" ]; then
      echo "$name: no key exists yet -- run ./pgp-create"
    elif present "$fpr"; then
      echo "$name: $fpr present"
    else
      echo "$name: $fpr not imported"
    fi
  done
  exit 0
  ;;
work) wanted=(work) ;;
personal) wanted=(personal) ;;
both) wanted=(work personal) ;;
*)
  usage
  exit 1
  ;;
esac

for tool in gpg age; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "pgp-import: no $tool on PATH" >&2
    echo "pgp-import: rebuild first -- ../home/gpg.nix installs gpg" >&2
    exit 1
  }
done

import_one() {
  local name=$1 fpr file
  case "$name" in
  work) fpr=$work_fpr ;;
  personal) fpr=$personal_fpr ;;
  esac
  file="$here/pgp-$name.age"

  if [ -z "$fpr" ]; then
    echo "pgp-import: $name has no fingerprint in pgp-keys.nix" >&2
    echo "pgp-import: run ./pgp-create once, on one machine, first" >&2
    exit 1
  fi
  if [ ! -f "$file" ]; then
    echo "pgp-import: $file does not exist" >&2
    exit 1
  fi

  # Importing a key that is already here is harmless, but the passphrase
  # prompt is not: it would ask for nothing.
  if present "$fpr"; then
    echo "$name: $fpr is already here"
    return
  fi

  # The terminal check belongs here and not at the top. Above, it would refuse
  # a run on a machine where every key is already in place -- which asks for no
  # passphrase and is exactly what a script or an agent would run.
  if [ ! -t 0 ]; then
    echo "pgp-import: $name is missing and importing it needs a terminal" >&2
    echo "pgp-import: run it yourself, it asks for the age passphrase" >&2
    exit 1
  fi

  echo "$name: decrypting $(basename "$file"), this asks for the age passphrase"
  age -d -i "$here/identity.age" "$file" | gpg --batch --quiet --import

  if ! present "$fpr"; then
    echo "pgp-import: $file did not yield $fpr" >&2
    exit 1
  fi

  # Ultimate trust, which gpg does not set on its own even for a key whose
  # secret half is present. Without it gpg calls your own key untrusted and
  # asks before encrypting to it.
  printf '%s:6:\n' "$fpr" | gpg --batch --quiet --import-ownertrust

  echo "$name: $fpr imported"
}

for name in "${wanted[@]}"; do
  import_one "$name"
done

echo
echo "The keys are still passphrase-protected. gpg-agent asks once and caches;"
echo "see ../home/gpg.nix for how long."
