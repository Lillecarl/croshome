result
overrides.nix

# The age identity in plaintext. Only ./secrets/identity.age, the passphrase
# encrypted form, belongs in this repository.
#
# ./secrets/unlock never writes here -- it decrypts through mktemp straight to
# /var/lib/agenix/identity -- so these patterns catch a hand-run `age-keygen`
# or an `age -d` aimed at the wrong place. That is exactly when a rule like
# this earns itself.
secrets/identity
secrets/identity.txt
secrets/*.key

# Python bytecode, from running the hook cases in place.
__pycache__/
*.pyc

# Claude Code's claude.ai skill sync bucket. It wrote itself in here while
# ~/.claude/skills was one symlink to this directory; home/agents.nix links
# each skill on its own now, so the live bucket is in $HOME and anything
# left here is a leftover.
home/claude/skills/synced/
