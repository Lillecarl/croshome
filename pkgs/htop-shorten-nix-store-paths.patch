diff -ruN htop.orig/Process.c htop/Process.c
--- a/Process.c	2026-11-22 14:06:36.889523963 +0100
+++ b/Process.c	2026-11-22 14:08:20.478353147 +0100
@@ -174,6 +174,72 @@
    return dstStr;
 }
 
+#define NIX_STORE_DIR "/nix/store/"
+#define NIX_STORE_DIR_LEN (sizeof(NIX_STORE_DIR) - 1)
+#define NIX_HASH_LEN 32
+/* "/n/s/" plus the first hash character and the dash */
+#define NIX_SHORT_LEN 7
+
+/* Nix's base32 alphabet leaves out e, o, t and u. */
+static bool isNixBase32(char c) {
+   return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z' && c != 'e' && c != 'o' && c != 't' && c != 'u');
+}
+
+/* Length of "/nix/store/<hash>-" at s, or 0 when s does not start with one. */
+static size_t nixStorePrefixLen(const char* s) {
+   if (strncmp(s, NIX_STORE_DIR, NIX_STORE_DIR_LEN) != 0)
+      return 0;
+   for (size_t i = 0; i < NIX_HASH_LEN; i++)
+      if (!isNixBase32(s[NIX_STORE_DIR_LEN + i]))
+         return 0;
+   if (s[NIX_STORE_DIR_LEN + NIX_HASH_LEN] != '-')
+      return 0;
+   return NIX_STORE_DIR_LEN + NIX_HASH_LEN + 1;
+}
+
+static size_t shiftPastDeletion(size_t pos, size_t at, size_t count) {
+   if (pos <= at)
+      return pos;
+   return pos >= at + count ? pos - count : at;
+}
+
+/*
+ * Rewrites every "/nix/store/<hash>-<name>" in s to "/n/s/<h>-<name>", the
+ * way fish abbreviates a path, in place. The highlights count characters,
+ * not bytes, so they move by what was cut before them.
+ */
+static void shortenNixStorePaths(char* s, ProcessCmdlineHighlight* highlights, size_t highlightCount) {
+   char* w = s;
+   size_t chars = 0;
+   for (const char* r = s; *r;) {
+      const size_t len = nixStorePrefixLen(r);
+      if (!len) {
+         if (((unsigned char)*r & 0xC0) != 0x80)
+            chars++;
+         *w++ = *r++;
+         continue;
+      }
+
+      const char hashStart = r[NIX_STORE_DIR_LEN];
+      r += len;
+      w = stpcpy(w, "/n/s/");
+      *w++ = hashStart;
+      *w++ = '-';
+
+      for (size_t i = 0; i < highlightCount; i++) {
+         ProcessCmdlineHighlight* hl = &highlights[i];
+         const size_t start = shiftPastDeletion(hl->offset, chars + NIX_SHORT_LEN, len - NIX_SHORT_LEN);
+         const size_t end = shiftPastDeletion(hl->offset + hl->length, chars + NIX_SHORT_LEN, len - NIX_SHORT_LEN);
+         hl->offset = start;
+         hl->length = end - start;
+      }
+      chars += NIX_SHORT_LEN;
+   }
+   *w = '\0';
+}
+
