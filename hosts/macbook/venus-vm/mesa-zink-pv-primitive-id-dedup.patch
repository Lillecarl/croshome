+static nir_def *
+lower_pv_mode_load_primitive_id(nir_builder *b)
+{
+   /* A generated passthrough GS already carries PrimitiveId as an input
+    * varying. Loading the system value as well would emit a second
+    * BuiltIn-PrimitiveId input and produce invalid SPIR-V, so reuse the
+    * varying when it exists. */
+   nir_variable *var = nir_find_variable_with_location(b->shader,
+                                                       nir_var_shader_in,
+                                                       VARYING_SLOT_PRIMITIVE_ID);
+   if (var)
+      return nir_load_var(b, var);
+   return nir_load_primitive_id(b);
+}
