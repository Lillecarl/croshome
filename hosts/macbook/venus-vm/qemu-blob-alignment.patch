diff -ru a/hw/display/virtio-gpu-base.c b/hw/display/virtio-gpu-base.c
--- a/hw/display/virtio-gpu-base.c	2026-10-11 00:07:49
+++ b/hw/display/virtio-gpu-base.c	2026-10-11 00:08:01
@@ -190,6 +190,12 @@
     }
 
     g->virtio_config.num_scanouts = cpu_to_le32(g->conf.max_outputs);
+    /*
+     * Blobs are mapped into the guest at host page granularity: on a 16K
+     * page host, HVF cannot map a 4K-aligned blob, and the guest's access
+     * to it then traps without a decodable syndrome.
+     */
+    g->virtio_config.blob_alignment = cpu_to_le32(qemu_real_host_page_size());
     virtio_init(VIRTIO_DEVICE(g), VIRTIO_ID_GPU,
                 sizeof(struct virtio_gpu_config));
 
@@ -231,6 +237,7 @@
     }
     if (virtio_gpu_blob_enabled(g->conf)) {
         features |= (1 << VIRTIO_GPU_F_RESOURCE_BLOB);
+        features |= (1 << VIRTIO_GPU_F_BLOB_ALIGNMENT);
     }
     if (virtio_gpu_context_init_enabled(g->conf)) {
         features |= (1 << VIRTIO_GPU_F_CONTEXT_INIT);
diff -ru a/include/standard-headers/linux/virtio_gpu.h b/include/standard-headers/linux/virtio_gpu.h
